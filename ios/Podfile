# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try running Flutter pub get."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.expand_path(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      # Suppression radicale du drapeau -G rejeté par Xcode 26
      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS', 'COMPILER_FLAGS'].each do |flag_key|
        if config.build_settings[flag_key]
          if config.build_settings[flag_key].is_a?(Array)
            config.build_settings[flag_key].reject! { |f| f.include?('-G') }
          else
            config.build_settings[flag_key] = config.build_settings[flag_key].gsub(/-G\b/, '')
          end
        end
      end
    end
  end

  # Nettoyage direct dans les fichiers .xcconfig et project.pbxproj de BoringSSL-GRPC
  Dir.glob("Pods/**/*.xcconfig").each do |file|
    text = File.read(file)
    new_contents = text.gsub(/-G\b/, "")
    File.open(file, "w") { |f| f.puts new_contents } if text != new_contents
  end

  pbxproj = "Pods/Pods.xcodeproj/project.pbxproj"
  if File.exist?(pbxproj)
    text = File.read(pbxproj)
    new_contents = text.gsub(/-G\b/, "")
    File.open(pbxproj, "w") { |f| f.puts new_contents } if text != new_contents
  end
end