platform :ios, '16.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist."
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# --- LE SECRET EST ICI : PRE-INSTALL HOOK ---
# Intercepte et nettoie les fichiers sources des pods dès leur téléchargement 
# avant la génération du projet Xcode par CocoaPods.
pre_install do |installer|
  # Parcourt le cache des pods pour supprimer toute trace de l'option -G dans les podspecs
  installer.pod_targets.each do |target|
    podspec_path = target.defined_in_file
    if podspec_path && File.exist?(podspec_path)
      content = File.read(podspec_path)
      if content.include?('-G')
        new_content = content.gsub(/-G\b/, '')
        File.write(podspec_path, new_content)
        puts "-> [CLEANED PODSPEC]: Nettoyage du flag -G dans #{target.name}"
      end
    end
  end
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.expand_path(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      
      # Double sécurité dans les configurations de build générées
      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS', 'WARNING_CFLAGS'].each do |field|
        if config.build_settings[field]
          if config.build_settings[field].is_a?(Array)
            config.build_settings[field].reject! { |item| item.to_s.include?('-G') }
          else
            config.build_settings[field] = config.build_settings[field].to_s.gsub(/-G\b/, '').strip
          end
        end
      end
    end
  end
end