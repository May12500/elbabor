post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # 1. Nettoyage au niveau de chaque fichier source individuel (cible BoringSSL-GRPC)
    if target.respond_to?(:source_build_phase) && target.source_build_phase
      target.source_build_phase.files.each do |file|
        if file.settings && file.settings['COMPILER_FLAGS']
          flags = file.settings['COMPILER_FLAGS'].split
          flags.reject! { |flag| flag == '-G' }
          file.settings['COMPILER_FLAGS'] = flags.join(' ')
        end
      end
    end

    # 2. Nettoyage au niveau des configurations de build du target
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS', 'COMPILER_FLAGS'].each do |flag_key|
        if config.build_settings[flag_key]
          if config.build_settings[flag_key].is_a?(Array)
            config.build_settings[flag_key].reject! { |f| f == '-G' }
          else
            config.build_settings[flag_key] = config.build_settings[flag_key].gsub(/(^|\s)-G(\s|$)/, ' ').strip
          end
        end
      end
    end
  end

  # 3. Nettoyage direct dans les fichiers .xcconfig générés par CocoaPods
  Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', '**', '*.xcconfig')).each do |xcconfig_path|
    content = File.read(xcconfig_path)
    new_content = content.gsub(/(^|\s)-G(\s|$)/, ' ')
    File.write(xcconfig_path, new_content) if content != new_content
  end
end