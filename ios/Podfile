platform :ios, '16.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist."
  end
  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.expand_path(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # 1. Nettoyage absolu de chaque fichier source individuel (PBXBuildFile)
    target.source_build_phase.files.each do |file|
      if file.settings && file.settings['COMPILER_FLAGS']
        flags = file.settings['COMPILER_FLAGS']
        if flags.is_a?(String)
          file.settings['COMPILER_FLAGS'] = flags.gsub(/-G\b/, '').strip
        elsif flags.is_a?(Array)
          file.settings['COMPILER_FLAGS'] = flags.reject { |f| f.to_s == '-G' }
        end
      end
    end if target.respond_to?(:source_build_phase) && target.source_build_phase

    # 2. Nettoyage global des configurations de build
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      config.build_settings.each do |key, value|
        if value.is_a?(String)
          config.build_settings[key] = value.gsub(/-G\b/, '').strip
        elsif value.is_a?(Array)
          config.build_settings[key] = value.reject { |v| v.to_s == '-G' }
        end
      end
    end
  end

  # 3. Nettoyage de tous les fichiers .xcconfig de CocoaPods
  Dir.glob(File.join(installer.sandbox.root, '**', '*.xcconfig')).each do |xcconfig_path|
    content = File.read(xcconfig_path)
    if content.include?('-G')
      new_content = content.gsub(/-G\b/, '')
      File.write(xcconfig_path, new_content)
    end
  end
end